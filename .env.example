DATABASE_URL="postgresql://postgres:1234@localhost:5432/wasel_palestine"

# Required for signing JWTs (login, refresh). Use a long random value; never commit real secrets.
# Docker Compose reads this from your project-root `.env` and passes it into the `api` container.
# Generate one (example): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your_secret_here"

# Docker Compose only: published host port for the `api` service (default 3000 if unset). Uncomment if 3000 is busy:
# DOCKER_API_PORT=3001

# External APIs (optional; improves alignment with coursework “authoritative sources”)
# When set, weather uses OpenWeatherMap (authenticated). Otherwise Open-Meteo (public, no key).
OPENWEATHER_API_KEY=

# OSRM-compatible routing base (default is the public OSRM demo server).
OSRM_BASE_URL=https://router.project-osrm.org

# Outbound HTTP hardening (timeouts, cache, in-process rate limit to external hosts)
EXTERNAL_HTTP_TIMEOUT_MS=10000
WEATHER_CACHE_TTL_SEC=600
ROUTE_CACHE_TTL_SEC=300
EXTERNAL_OUTBOUND_RPM=60