{
  "info": {
    "name": "Wasel Palestine API",
    "description": "Starter collection for coursework. Import `openapi.json` into API Dog for full coverage; use this for quick smoke tests or as a Postman-compatible companion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Incidents",
      "item": [
        {
          "name": "List incidents (filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/incidents?page=1&limit=10&sort=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "incidents"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "desc" },
                { "key": "status", "value": "", "disabled": true },
                { "key": "severity", "value": "", "disabled": true },
                { "key": "type", "value": "", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "External",
      "item": [
        {
          "name": "Weather (Open-Meteo / OpenWeather)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/external/weather?lat=32.22&lng=35.25"
          }
        },
        {
          "name": "Route preview (OSRM)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": { \"lat\": 32.22, \"lng\": 35.25 },\n  \"destination\": { \"lat\": 31.9, \"lng\": 35.2 }\n}"
            },
            "url": "{{baseUrl}}/api/v1/external/route-preview"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@wasel.local\",\n  \"password\": \"ChangeMeAdmin123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Me (Bearer)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    }
  ]
}
